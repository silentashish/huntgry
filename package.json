{
  "name": "huntgry",
  "productName": "Huntgry",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/shared/remote",
    "relay",
    "mobile"
  ],
  "description": "Local-first Electron dashboard around the Claude resume-tailor skill",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/brand-dev-electron.cjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "icons": "sh scripts/build-icons.sh",
    "test": "npm run check:lockfiles && vitest run && npm run test --workspace relay",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:page && npm run typecheck:remote && npm run typecheck:e2e && npm run typecheck:relay",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:page": "tsc --noEmit -p tsconfig.page.json",
    "typecheck:remote": "tsc --noEmit -p src/shared/remote/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck:relay": "npm run typecheck --workspace relay",
    "postinstall": "node -e \"require('electron')\" && node scripts/brand-dev-electron.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "d3-force-3d": "^3.0.6",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tweetnacl": "^1.0.3",
    "unpdf": "^1.8.1"
  }
}
